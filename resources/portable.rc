#include <windows.h>

1 RT_MANIFEST "portable.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "f1nando - community build\0"
            VALUE "FileDescription", "Engine Sim Lab - unofficial native modernization\0"
            VALUE "FileVersion", "1.0.0-lab.1\0"
            VALUE "InternalName", "EngineSim\0"
            VALUE "OriginalFilename", "EngineSim.exe\0"
            VALUE "ProductName", "Engine Sim Lab\0"
            VALUE "ProductVersion", "1.0.0-lab.1\0"
            VALUE "LegalCopyright", "Based on Engine Simulator by Ange Yaghi. See LICENSES.\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
